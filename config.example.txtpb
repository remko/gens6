# Simple service
services {
  name: "syncthing"
  run: "syncthing --no-browser"
}

# Service with upstream dependencies
services {
  name: "pipewire"
  # Set an environment variable to a file descriptor that PipeWire can 
  # use to signal when it's ready.
  ready: { fd: { env: "PIPEWIRE_NOTIFICATION_FD" } }
  run: "/usr/bin/pipewire"
}

# Service depending on another service
services {
  name: "pipewire-pulse"
  # Wait for pipewire to signal it's ready
  dependencies: ["pipewire"]
  run: "/usr/bin/pipewire-pulse"
}

# A custom Sway config writes the value of WAYLAND_DISPLAY and SWAYSOCK to 
# files in the _env dir, and then notifies it's ready via SWAY_NOTIFICATION_FD.
# Upstream services can then pick up the environment variables from the _env dir.
services {
  name: "sway"
  ready: { fd: { env: "SWAY_NOTIFICATION_FD" } }
  run: "sway"
}

# Wait for Sway, and then import the necessary environment variables to be able
# to connect to sway
services {
  name: "wlsunset"
  dependencies: ["sway"]
  run: 
    "s6-envdir ../_env\n"
    "wlsunset -l 50.881531 -L 4.841330\n"
}

# Example of a custom finish script, called at service exit.
services {
  name: "iwgtk"
  dependencies: ["sway"]
  run: 
    "s6-envdir ../_env\n"
    "iwgtk -i\n"
  # iwgtk isn't always installed. If it fails because it wasn't found (exit code 127), 
  # make it a permanent failure and don't try to restart.
  finish: "s6-permafailon 5 1 127"
}
